{
  "name": "theweblish",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/enquiry.test.ts tests/blog.test.ts tests/contact.test.ts tests/media.test.ts tests/ticket.test.ts tests/services.test.ts tests/portfolio.test.ts",
    "test:db": "tsx --test tests/enquiry-db.test.ts tests/blog-db.test.ts tests/portfolio-db.test.ts tests/media-db.test.ts",
    "test:http": "tsx tests/http-smoke.ts",
    "test:http:portfolio": "tsx tests/portfolio-http-smoke.ts",
    "test:http:services": "tsx tests/service-http-smoke.ts",
    "test:http:settings": "tsx tests/settings-http-smoke.ts",
    "test:storage": "tsx tests/storage-http-smoke.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:cleanup-rate-limits": "tsx scripts/cleanup-rate-limits.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
    "@better-auth/prisma-adapter": "^1.7.6",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "better-auth": "^1.7.6",
    "lenis": "1.3.26",
    "mariadb": "^3.4.5",
    "next": "^16.3.6",
    "nodemailer": "^10.0.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "auth": "^1.7.6",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.6",
    "postcss": "^8.5.0",
    "prisma": "7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
